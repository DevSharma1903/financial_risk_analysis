        <!-- ==================== STAGE 4: SWIMLANE & NODES ==================== -->
        <mxCell id="lane4" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;STAGE 4: Multi-Model Benchmarking&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size: 11px;&quot;&gt;src/04_train.py&lt;/i&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#5E35B1;fontColor=#311B92;startSize=50;rounded=1;arcSize=4;shadow=1;" vertex="1" parent="1">
