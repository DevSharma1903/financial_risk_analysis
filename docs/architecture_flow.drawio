        <mxCell id="lane3" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;STAGE 3: Hybrid Feature Vectorization&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size: 11px;&quot;&gt;src/03_feature_engine.py&lt;/i&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0288D1;fontColor=#01579B;startSize=50;rounded=1;arcSize=4;shadow=1;" vertex="1" parent="1">
