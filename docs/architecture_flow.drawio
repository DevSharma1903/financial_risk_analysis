        <mxCell id="s2_node1" value="&lt;b&gt;Target Ingestion &amp;amp; Cache Check&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;• Read &#39;labeled_index.csv&#39;&lt;br&gt;• Skip already cached ADSHs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#26A69A;fontColor=#004D40;arcSize=8;" vertex="1" parent="lane2">
