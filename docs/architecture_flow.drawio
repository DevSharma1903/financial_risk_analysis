        </mxCell>
        <mxCell id="s3_node2a" value="&lt;b&gt;Loughran-McDonald&lt;br&gt;Master Dictionary&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Tone Proportions (4-dim)&lt;br&gt;• Negative&lt;br&gt;• Uncertainty&lt;br&gt;• Litigious&lt;br&gt;• Constraining&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0288D1;fontColor=#01579B;arcSize=8;" vertex="1" parent="lane3">
          <mxGeometry x="20" y="150" width="130" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s3_node2b" value="&lt;b&gt;Risk N-Gram&lt;br&gt;TF-IDF Lexicon&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Domain Red Flags (8-dim)&lt;br&gt;• &#39;material weakness&#39;&lt;br&gt;• &#39;restatement&#39;&lt;br&gt;• &#39;non-reliance&#39;&lt;br&gt;• &#39;going concern&#39;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0288D1;fontColor=#01579B;arcSize=8;" vertex="1" parent="lane3">
          <mxGeometry x="170" y="150" width="130" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s3_node3" value="&lt;b&gt;Contextual Semantic Embeddings&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;b&gt;ProsusAI/finbert&lt;/b&gt; (768-dimensional)&lt;br&gt;• Sliding Window Chunking (512 max, 256 stride)&lt;br&gt;• Zero-Truncation: Full Document Coverage&lt;br&gt;• Document-Level Mean Pooling&lt;br&gt;• Batched PyTorch &lt;i&gt;torch.no_grad()&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#29B6F6;fontColor=#01579B;arcSize=8;" vertex="1" parent="lane3">
          <mxGeometry x="20" y="300" width="280" height="110" as="geometry" />
