        <mxCell id="s3_node4" value="&lt;b&gt;Multimodal Feature Concatenation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Horizontal Fusion Matrix:&lt;br&gt;[4 LM] + [8 TF-IDF] + [768 FinBERT]&lt;br&gt;&lt;b&gt;→ Unified (N, 780) Dense Feature Space&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0288D1;fontColor=#01579B;arcSize=8;" vertex="1" parent="lane3">
