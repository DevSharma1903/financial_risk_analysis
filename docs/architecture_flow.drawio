        <mxCell id="s4_node3" value="&lt;b&gt;Model Benchmark Tournament&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;1. &lt;b&gt;Logistic Regression&lt;/b&gt; (L2 Pipeline)&lt;br&gt;2. &lt;b&gt;Linear SVM&lt;/b&gt; (SGD ElasticNet)&lt;br&gt;3. &lt;b&gt;Random Forest&lt;/b&gt; (Balanced Bagging)&lt;br&gt;4. &lt;b&gt;XGBoost&lt;/b&gt; (Regularized Boosted Trees)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5E35B1;fontColor=#311B92;arcSize=8;" vertex="1" parent="lane4">
