        <mxCell id="s4_node2" value="&lt;b&gt;Validation &amp;amp; Scaling Setup&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;• Stratified 5-Fold Cross Validation&lt;br&gt;• StandardScaler Pipelines&lt;br&gt;• Class weighting (scale_pos_weight)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7E57C2;fontColor=#311B92;arcSize=8;" vertex="1" parent="lane4">
